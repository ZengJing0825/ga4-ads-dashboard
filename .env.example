# === GA4 ===
# GA4 Property ID (GA4 Admin -> Property settings; numeric)
GA4_PROPERTY_ID=YOUR_GA4_PROPERTY_ID

# Path to the service account JSON key.
# Create a service account in Google Cloud Console, download its JSON key,
# then add the service account email as Viewer under
# GA4 -> Admin -> Property access management.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/ga4-service-account.json

# === Google Ads ===
# Customer ID without dashes (digits only)
GOOGLE_ADS_CUSTOMER_ID=YOUR_GOOGLE_ADS_CUSTOMER_ID
# Manager (MCC) account ID, if the customer is accessed through a manager account. Leave empty otherwise.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=YOUR_GOOGLE_ADS_MANAGER_ID
# Developer token (Google Ads -> Tools -> API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=YOUR_DEVELOPER_TOKEN
# OAuth2 "Desktop app" client (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_ADS_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
GOOGLE_ADS_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
# Generate with: python3 scripts/get_refresh_token.py
GOOGLE_ADS_REFRESH_TOKEN=YOUR_REFRESH_TOKEN

# === General ===
# Number of days to pull
DATA_DAYS=30
# Raw output directory (merged dashboard data goes to dashboard/data.json)
OUTPUT_DIR=./data
# UTC offset (hours) of your GA4 property / Google Ads account timezone, used to compute the date window
REPORT_TZ_OFFSET_HOURS=-7
